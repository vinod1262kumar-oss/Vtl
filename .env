# API Configuration
REACT_APP_API_BASE_URL=https://api.veridis.bio
REACT_APP_API_TIMEOUT=30000

# Authentication Keys (Add your keys here)
REACT_APP_AUTH_API_KEY=your_auth_api_key_here
REACT_APP_JWT_SECRET=your_jwt_secret_here

# Database Configuration
REACT_APP_DB_HOST=localhost
REACT_APP_DB_PORT=5432
REACT_APP_DB_NAME=veridis_nutrition
REACT_APP_DB_USER=admin
REACT_APP_DB_PASSWORD=your_database_password_here

# AI/ML Service Keys
REACT_APP_SPECTRAL_AI_KEY=your_spectral_ai_key_here
REACT_APP_ML_MODEL_VERSION=v3.4

# Google Maps & External Services
REACT_APP_GOOGLE_MAPS_API_KEY=your_google_maps_key_here
REACT_APP_GOOGLE_ANALYTICS_ID=your_analytics_id_here

# Firebase Configuration (if using)
REACT_APP_FIREBASE_API_KEY=your_firebase_api_key_here
REACT_APP_FIREBASE_PROJECT_ID=your_firebase_project_id
REACT_APP_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
REACT_APP_FIREBASE_APP_ID=your_firebase_app_id

# Stripe Payment Integration
REACT_APP_STRIPE_PUBLIC_KEY=your_stripe_public_key_here

# Environment
REACT_APP_ENVIRONMENT=development
REACT_APP_DEBUG_MODE=false

# Security
REACT_APP_ENABLE_HTTPS=true
REACT_APP_CSRF_TOKEN_HEADER=X-CSRF-Token
